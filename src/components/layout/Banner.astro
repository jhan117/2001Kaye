---
import { SITE } from "@src/config";

interface Props {
    image?: string;
}

const { image } = Astro.props;

const isDefaultBanner = !image || image === SITE.bannerImg;
---

<div class="banner-container">
    {isDefaultBanner ? (
        <>
            <div class="banner-image dark-banner" style="background-image: url(/banner.jpg)"></div>
            <div class="banner-image light-banner" style="background-image: url(/banner_light.jpg)"></div>
        </>
    ) : (
        <div class="banner-image" style={`background-image: url(${image})`}></div>
    )}
</div>
<div class="banner-spacer"></div>

<style>
    .banner-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 13rem; 
        overflow: hidden;
        z-index: 0;
    }

    
    .banner-spacer {
        width: 100%;
        height: 6.75rem; 
        margin-bottom: 0;
    }

    @media (min-width: 48rem) {
        .banner-container {
            height: 28rem; 
        }
        .banner-spacer {
            height: 21.75rem; 
        }
    }

    .banner-image {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center 80%; 
    }

    .dark-banner {
        display: block;
    }

    .light-banner {
        display: none;
    }

    :global(html[data-theme="light"]) .dark-banner {
        display: none;
    }

    :global(html[data-theme="light"]) .light-banner {
        display: block;
    }

    
    .banner-gradient {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, hsl(222, 50%, 8%) 0%, hsl(222, 45%, 15%) 100%);
        position: relative;
        overflow: hidden;
    }

    
    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.5;
    }

    .orb-1 {
        width: 15rem;
        height: 15rem;
        background-color: var(--accent);
        top: -5rem;
        right: 5rem;
        animation: float-slow 15s infinite alternate;
    }

    .orb-2 {
        width: 12rem;
        height: 12rem;
        background-color: hsl(190, 100%, 50%);
        bottom: -3rem;
        left: 3rem;
        animation: float-slower 20s infinite alternate;
    }

    .orb-3 {
        width: 8rem;
        height: 8rem;
        background-color: hsl(230, 80%, 40%);
        top: 2rem;
        left: 40%;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 20px 20px;
    }

    .banner-content {
        position: absolute;
        bottom: 1.5rem;
        left: 2rem;
        z-index: 10;
    }

    .banner-tagline {
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: transparent;
        background: linear-gradient(to right, var(--text-primary), var(--accent-hover));
        -webkit-background-clip: text;
        background-clip: text;
        opacity: 0.9;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    @keyframes float-slow {
        0% { transform: translateY(0) scale(1); }
        100% { transform: translateY(20px) scale(1.1); }
    }

    @keyframes float-slower {
        0% { transform: translateY(0) scale(1); }
        100% { transform: translateY(-20px) scale(0.9); }
    }
</style>
