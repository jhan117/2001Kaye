    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={`lucide-svg ${className}`} 
    style={style}
    set:html={svgContent}
