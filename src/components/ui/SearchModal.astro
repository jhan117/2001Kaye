---
import Icon from "@components/ui/Icon.astro";
---

<div id="searchModal" class="search-modal hidden">
    <div class="search-modal-backdrop" id="searchBackdrop"></div>
    <div class="search-modal-content glass-card">
        <div class="search-header">
            <Icon name="search" class="search-icon" />
            <input type="text" id="searchInput" placeholder="검색어를 입력하세요..." autocomplete="off" />
            <button id="searchClose" class="close-btn" aria-label="Close search">
                <Icon name="close" />
            </button>
        </div>
        <div class="search-results-container">
            <ul id="searchResults" class="search-results">
                <li class="search-empty">검색어를 입력해주세요.</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .search-modal {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 10vh;
        visibility: visible;
        opacity: 1;
        transition: opacity 0.2s, visibility 0.2s;
    }

    .search-modal.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .search-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }

    .search-modal-content {
        position: relative;
        width: 100%;
        max-width: 40rem;
        margin: 0 1rem;
        display: flex;
        flex-direction: column;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        transform: translateY(0);
        transition: transform 0.2s;
    }

    .search-modal.hidden .search-modal-content {
        transform: translateY(-20px);
    }

    .search-header {
        display: flex;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--card-border);
        gap: 1rem;
    }

    .search-header :global(.search-icon) {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--accent);
    }

    #searchInput {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-primary);
        font-size: 1.1rem;
    }

    #searchInput::placeholder {
        color: var(--text-muted);
    }

    .close-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        padding: 0.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.25rem;
    }

    .close-btn:hover {
        color: var(--error-color);
        background: rgba(255, 0, 0, 0.1);
    }

    .close-btn :global(svg) {
        width: 1.25rem;
        height: 1.25rem;
    }

    .search-results-container {
        max-height: 60vh;
        overflow-y: auto;
        padding: 1rem 1.5rem;
    }

    .search-results {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .search-empty {
        text-align: center;
        color: var(--text-muted);
        padding: 2rem 0;
    }

    :global(.search-result-item) {
        display: flex;
        flex-direction: column;
        padding: 0.75rem 1rem;
        border-radius: var(--btn-radius);
        text-decoration: none;
        color: var(--text-secondary);
        border: 1px solid transparent;
        transition: background-color 0.15s, border-color 0.15s;
    }

    :global(.search-result-item:hover) {
        background: var(--primary-700);
        border-color: var(--card-border);
        color: var(--text-primary);
    }

    :global(.search-result-title) {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.25rem;
    }

    :global(.search-result-meta) {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        font-size: 0.8rem;
    }

    :global(.search-meta-item) {
        background-color: var(--card-border);
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
        color: var(--text-muted);
    }

    :global(.search-result-desc) {
        font-size: 0.875rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<script>
    let searchData: any[] | null = null;

    const setupSearch = () => {
        const modal = document.getElementById('searchModal');
        const backdrop = document.getElementById('searchBackdrop');
        const closeBtn = document.getElementById('searchClose');
        const input = document.getElementById('searchInput') as HTMLInputElement | null;
        const results = document.getElementById('searchResults');
        const searchTrigger = document.getElementById('searchTrigger');

        const loadSearchData = async () => {
            if (searchData) return;
            try {
                const res = await fetch('/search.json');
                searchData = await res.json();
            } catch (err) {
                console.error('Failed to load search data', err);
            }
        };

        const openSearch = () => {
            if (modal) modal.classList.remove('hidden');
            if (input) input.focus();
            loadSearchData();
        };

        const closeSearch = () => {
            if (modal) modal.classList.add('hidden');
            if (input) input.value = '';
            renderResults('');
        };

        const renderResults = (query: string) => {
            if (!results) return;

            if (!query) {
                results.innerHTML = '<li class="search-empty">검색어를 입력해주세요.</li>';
                return;
            }

            if (!searchData) {
                results.innerHTML = '<li class="search-empty">데이터를 불러오는 중...</li>';
                return;
            }

            const q = query.toLowerCase();
            const filtered = searchData.filter((post: any) => 
                post.title.toLowerCase().includes(q) || 
                post.description?.toLowerCase().includes(q) ||
                post.body?.toLowerCase().includes(q)
            );

            if (filtered.length === 0) {
                results.innerHTML = '<li class="search-empty">검색 결과가 없습니다.</li>';
                return;
            }

            results.innerHTML = filtered.map((post: any) => {
                const dateStr = post.pubDate ? new Date(post.pubDate).toISOString().split('T')[0] : '';
                return `
                    <li>
                        <a href="/posts/${post.slug}" class="search-result-item">
                            <span class="search-result-title">${post.title}</span>
                            <div class="search-result-meta">
                                ${post.category ? `<span class="search-meta-item cat">${post.category}</span>` : ''}
                                ${dateStr ? `<span class="search-meta-item date">${dateStr}</span>` : ''}
                            </div>
                            <span class="search-result-desc">${post.description || ''}</span>
                        </a>
                    </li>
                `;
            }).join('');
        };

        if (searchTrigger) {
            // 중복 이벤트 방지를 위한 기존 리스너 제거
            searchTrigger.replaceWith(searchTrigger.cloneNode(true));
            document.getElementById('searchTrigger')?.addEventListener('click', openSearch);
        }
        if (backdrop) backdrop.addEventListener('click', closeSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        
        if (input) {
            input.addEventListener('input', (e) => {
                renderResults((e.target as HTMLInputElement).value);
            });
        }

        // 전역 키보드 이벤트 중복 등록 방지
        if (!(window as any).__searchListenerAdded) {
            document.addEventListener('keydown', (e: KeyboardEvent) => {
                const currentModal = document.getElementById('searchModal');
                if (e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) {
                    e.preventDefault();
                    openSearch();
                } else if (e.key === 'Escape' && currentModal && !currentModal.classList.contains('hidden')) {
                    closeSearch();
                }
            });
            (window as any).__searchListenerAdded = true;
        }
    };

    // 초기 로드 및 페이지 전환 시 스크립트 초기화
    document.addEventListener('astro:page-load', setupSearch);
</script>
