---
export interface Props {
    headings: { depth: number; slug: string; text: string }[];
    isMobile?: boolean;
}

const { headings, isMobile = false } = Astro.props;

// h2, h3 태그만 목차에 표시
const filteredHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

{filteredHeadings.length > 0 && (
    <aside class={`toc-container glass-card ${isMobile ? 'mobile-mode' : 'desktop-mode'}`}>
        <h3 class="toc-title">목차</h3>
        <ul class="toc-list">
            {filteredHeadings.map(heading => (
                <li class={`toc-item depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
            ))}
        </ul>
    </aside>
)}

<style>
    .toc-container {
        padding: 1.5rem;
        width: 100%;
    }

    .desktop-mode {
        position: sticky;
        top: 6rem;
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        display: none;
    }

    
    @media (min-width: 80rem) {
        .desktop-mode {
            display: block;
            width: 220px;
        }
    }

    .mobile-mode {
        display: block;
        margin-bottom: 2rem;
    }

    .toc-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text-primary);
        border-bottom: 1px solid var(--card-border);
        padding-bottom: 0.5rem;
    }

    .toc-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .toc-item a {
        font-size: 0.9rem;
        color: var(--text-secondary);
        display: block;
        line-height: 1.4;
        transition: color 0.2s;
    }

    .toc-item a:hover,
    .toc-item a.active {
        color: var(--accent);
    }
    
    .toc-item a.active {
        font-weight: 600;
    }

    .depth-2 {
        padding-left: 0;
        font-weight: 500;
    }

    .depth-3 {
        padding-left: 1rem;
        font-size: 0.85rem;
        position: relative;
    }

    .depth-3::before {
        content: "-";
        position: absolute;
        left: 0.25rem;
        color: var(--card-border);
    }
</style>

<script>
    const setupTOC = () => {
        // 기존 옵저버 해제 (페이지 전환 시 중복 방지)
        if ((window as any).__tocObserver) {
            (window as any).__tocObserver.disconnect();
        }

                const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                const id = entry.target.getAttribute('id');
                const tocLinks = document.querySelectorAll(`.toc-item a[href="#${id}"]`);
                if (tocLinks.length > 0) {
                    if (entry.isIntersecting) {
                        document.querySelectorAll('.toc-item a').forEach(a => {
                            a.classList.remove('active');
                        });
                        tocLinks.forEach(link => {
                            link.classList.add('active');
                        });
                    }
                }
            });
        }, {
            // 상단 부근에 도달했을 때 감지되도록 여백 설정
            rootMargin: '-5% 0px -80% 0px'
        });

        document.querySelectorAll('.markdown-content h2, .markdown-content h3').forEach((section) => {
            observer.observe(section);
        });

        (window as any).__tocObserver = observer;
    };

    document.addEventListener('astro:page-load', setupTOC);
</script>
