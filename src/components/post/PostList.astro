---
import MetaInfo from "./MetaInfo.astro";
import Icon from "@components/ui/Icon.astro";
import { timeSince } from "@utils/date";
import type { Post } from "@types";

interface Props {
    data: Post[];
}

const { data } = Astro.props;
---

<div class="posts-container">
    {data && data.length > 0 ? (
        <ul class="posts-list">
            {data.map((post) => (
                <li class="glass-card post-card">
                    <div class="post-header">
                        <a href={`/posts/${post.slug}`} class="post-title-link">
                            <h2 class="post-title">
                                {post.data.draft && <span class="draft-badge">[Draft]</span>}
                                {post.data.title}
                            </h2>
                        </a>
                        <span class="post-time">{timeSince(post.data.pubDate)}</span>
                    </div>
                    
                    <div class="post-meta-wrapper">
                        <MetaInfo 
                            pubDate={post.data.pubDate} 
                            updatedDate={post.data.updatedDate}
                            category={post.data.category} 
                            tags={post.data.tags}
                        />
                    </div>
                    
                    <p class="post-description">{post.data.description}</p>
                    
                    <div class="post-footer">
                        <a href={`/posts/${post.slug}`} class="read-more-btn">
                            Read More
                            <Icon name="arrow-right" class="icon" />
                        </a>
                    </div>
                </li>
            ))}
        </ul>
    ) : (
        <div class="glass-card empty-state">
            <Icon name="empty" class="icon-empty" />
            <p>등록된 게시물이 없습니다.</p>
        </div>
    )}
</div>

<style>
    .posts-container {
        width: 100%;
    }

    .posts-list {
        display: flex;
        flex-direction: column;
        row-gap: 1.5rem;
    }

    .post-card {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        row-gap: 1rem;
        position: relative;
        overflow: hidden;
    }

    /* 카드 호버 효과 */
    .post-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, var(--accent) 0%, hsl(225, 90%, 60%) 100%);
        opacity: 0;
        transition: opacity var(--transition-normal);
    }

    .post-card:hover::after {
        opacity: 1;
    }

    .post-card:hover {
        transform: translateY(-4px);
    }

    .post-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        column-gap: 1rem;
    }

    .post-title-link {
        flex: 1;
    }

    .post-title {
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1.4;
        color: var(--text-primary);
        transition: color var(--transition-fast);
    }

    .post-title-link:hover .post-title {
        color: var(--accent);
    }

    .draft-badge {
        display: inline-block;
        font-size: 0.85rem;
        background-color: var(--warning-color);
        color: var(--bg-color);
        padding: 0.1rem 0.5rem;
        border-radius: var(--btn-radius);
        margin-right: 0.5rem;
        vertical-align: middle;
    }

    .post-time {
        font-size: 0.75rem;
        color: var(--text-muted);
        white-space: nowrap;
        background-color: var(--primary-700);
        padding: 0.25rem 0.5rem;
        border-radius: var(--btn-radius);
        border: 1px solid var(--card-border);
    }

    .post-meta-wrapper {
        margin: -0.25rem 0;
    }

    .post-description {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.5rem;
    }

    .read-more-btn {
        display: flex;
        align-items: center;
        column-gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--accent);
        padding: 0.5rem 1rem;
        border-radius: var(--btn-radius);
        background-color: rgba(0, 150, 255, 0.05);
        border: 1px solid rgba(0, 150, 255, 0.15);
        transition: all var(--transition-fast);
    }

    .read-more-btn:hover {
        background-color: var(--accent);
        color: var(--bg-color);
        border-color: var(--accent);
        transform: translateX(4px);
    }

    :global(.lucide-svg.icon) {
        width: 1rem;
        height: 1rem;
        transition: transform var(--transition-fast);
    }

    .read-more-btn:hover :global(.icon) {
        transform: translateX(3px);
    }

    /* 빈 상태 */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-secondary);
        row-gap: 1rem;
    }

    :global(.lucide-svg.icon-empty) {
        width: 3rem;
        height: 3rem;
        color: var(--text-muted);
    }
</style>
