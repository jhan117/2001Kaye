---
import Icon from "@components/ui/Icon.astro";
import { formatDate } from "@utils/date";

interface Props {
    pubDate: Date;
    updatedDate?: Date;
    category?: string;
    tags?: string[];
    readingTime?: string;
}

const { pubDate, updatedDate, category, tags = [], readingTime } = Astro.props;
---

<div class="meta-info">
    <div class="meta-item">
        <Icon name="calendar" class="icon" />
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>
    
    {updatedDate && (
        <div class="meta-item" title="최종 수정일">
            <Icon name="edit" class="icon" />
            <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </div>
    )}

    {category && (
        <a href={`/category/${category}`} class="meta-item category-link">
            <Icon name="folder" class="icon" />
            <span>{category}</span>
        </a>
    )}
    
    {readingTime && (
        <div class="meta-item">
            <Icon name="clock" class="icon" />
            <span>{readingTime}</span>
        </div>
    )}
</div>

{tags.length > 0 && (
    <div class="tags-container">
        {tags.map(tag => (
            <a href={`/tags/${tag}`} class="tag-badge">#{tag}</a>
        ))}
    </div>
)}

<style>
    .meta-info {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.825rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .meta-item {
        display: flex;
        align-items: center;
        column-gap: 0.4rem;
    }

    :global(.lucide-svg) {
        width: 0.95rem;
        height: 0.95rem;
    }

    :global(.icon) {
        color: var(--accent);
    }

    .category-link {
        color: var(--text-muted);
        transition: color var(--transition-fast);
    }

    .category-link:hover {
        color: var(--accent);
    }

    .text {
        line-height: 1;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .tag-badge {
        font-size: 0.75rem;
        padding: 0.2rem 0.6rem;
        background-color: var(--primary-700);
        color: var(--accent);
        border-radius: 1rem;
        border: 1px solid var(--card-border);
        font-weight: 600;
    }
</style>
