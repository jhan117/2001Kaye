---
import Icon from "@components/ui/Icon.astro";
import type { Post } from "@types";

interface Props {
    post: Post;
    direction: "prev" | "next";
}

const { post, direction } = Astro.props;
---

<a href={`/posts/${post.slug}`} class="glass-card nav-item-link">
    <div class={`nav-item-content ${direction}`}>
        {direction === "prev" && (
            <div class="icon-wrapper prev-icon">
                <Icon name="chevron-left" />
            </div>
        )}
        <div class="text-content">
            <span class="nav-label">{direction === "prev" ? "이전 글" : "다음 글"}</span>
            <h4 class="nav-title">{post.data.title}</h4>
        </div>
        {direction === "next" && (
            <div class="icon-wrapper next-icon">
                <Icon name="chevron-right" />
            </div>
        )}
    </div>
</a>

<style>
    .nav-item-link {
        display: block;
        flex: 1;
        min-width: 0; 
        padding: 1.25rem 1.5rem;
        transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
    }

    .nav-item-link:hover {
        transform: translateY(-2px);
        border-color: var(--card-border-hover);
        box-shadow: var(--shadow-hover);
    }

    .nav-item-content {
        display: flex;
        align-items: center;
        column-gap: 1rem;
        height: 100%;
        width: 100%;
        min-width: 0; 
    }

    @media (min-width: 56rem) {
        .nav-item-content.next {
            justify-content: flex-end;
            text-align: right;
        }
    }

    .text-content {
        display: flex;
        flex-direction: column;
        row-gap: 0.25rem;
        flex: 1;
        min-width: 0; 
    }

    .nav-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .nav-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color var(--transition-fast);
    }

    .nav-item-link:hover .nav-title {
        color: var(--accent);
    }

    .icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background-color: var(--primary-700);
        border: 1px solid var(--card-border);
        color: var(--text-secondary);
        font-size: 0.825rem;
        transition: all var(--transition-fast);
    }

    .nav-item-link:hover .icon-wrapper {
        background-color: var(--accent);
        color: var(--bg-color);
        border-color: var(--accent);
    }

    .icon-wrapper :global(.lucide-svg) {
        width: 1rem;
        height: 1rem;
        transition: transform 0.3s ease;
    }

    .nav-item-link:hover .prev-icon :global(.lucide-svg) {
        transform: translateX(-2px);
    }

    .nav-item-link:hover .next-icon :global(.lucide-svg) {
        transform: translateX(2px);
    }
</style>
