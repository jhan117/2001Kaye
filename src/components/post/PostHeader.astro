---
import MetaInfo from "./MetaInfo.astro";
import Icon from "@components/ui/Icon.astro";
import { timeSince } from "@utils/date";
import type { Post } from "@types";

interface Props {
    currPost: Post;
    readingTime?: string;
}

const { currPost, readingTime } = Astro.props;
---

<div class="post-header-container">
    <div class="time-badge">
        <Icon name="clock" class="icon" />
        <span>{timeSince(currPost.data.pubDate)}</span>
    </div>
    <h1 class="post-title">
        {currPost.data.draft && <span class="draft-badge">[Draft]</span>}
        {currPost.data.title}
    </h1>
    <div class="meta-divider"></div>
    <MetaInfo 
        pubDate={currPost.data.pubDate} 
        updatedDate={currPost.data.updatedDate} 
        category={currPost.data.category} 
        tags={currPost.data.tags}
        readingTime={readingTime}
    />
</div>

<style>
    .post-header-container {
        display: flex;
        flex-direction: column;
        row-gap: 0.75rem;
    }

    .time-badge {
        display: inline-flex;
        align-items: center;
        column-gap: 0.35rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        background-color: var(--primary-700);
        padding: 0.25rem 0.5rem;
        border-radius: var(--btn-radius);
        border: 1px solid var(--card-border);
        align-self: flex-start;
        font-weight: 600;
    }

    :global(.lucide-svg.icon) {
        width: 0.85rem;
        height: 0.85rem;
        color: var(--accent);
    }

    .post-title {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.3;
        color: var(--text-primary);
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
    }

    .draft-badge {
        display: inline-block;
        font-size: 0.9rem;
        background-color: var(--warning-color);
        color: var(--bg-color);
        padding: 0.2rem 0.6rem;
        border-radius: var(--btn-radius);
        margin-right: 0.5rem;
        vertical-align: middle;
        font-weight: 600;
    }

    .meta-divider {
        height: 1px;
        background-color: var(--card-border);
        margin: 0.5rem 0;
        width: 100%;
    }
</style>
