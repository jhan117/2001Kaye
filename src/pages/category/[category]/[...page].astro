---
import type {GetStaticPaths} from "astro";
import {getCollection} from "astro:content";

import Layout from "@layouts/Layout.astro";
import PostList from "@components/post/PostList.astro";
import Pagination from "@components/ui/Pagination.astro";
import Icon from "@components/ui/Icon.astro";
import type { Post } from "@types";
import { sortPostsByPubDate, getCategories } from "@utils/posts";

export const getStaticPaths = (async ({paginate}) => {
    const posts = await getCollection("posts");
    const categories = getCategories(posts as Post[]).map(c => c.name);
    
    return categories.flatMap((category) => {
        const filteredPosts = (posts as Post[]).filter(post => (post.data.category || 'Uncategorized') === category);
        const sortedPosts = sortPostsByPubDate(filteredPosts);
        return paginate(sortedPosts, {
            params: { category },
            pageSize: 5
        });
    });
}) satisfies GetStaticPaths;

const {page} = Astro.props;
const {category} = Astro.params;

export const prerender = true;
---

<Layout title={`${category} - 2001Kaye`}>
    <div class="category-header">
        <Icon name="layers" class="category-icon" />
        <h2 class="category-title">
            <span class="category-highlight">{category}</span> 카테고리 글
        </h2>
        <span class="count-badge">{page?.total} posts</span>
    </div>
    <PostList data={page?.data}/>
    <Pagination page={page}/>
</Layout>

<style>
    .category-header {
        margin-bottom: 2rem;
        padding: 1.25rem 1.5rem;
        background: var(--card-bg);
        border-radius: var(--card-radius);
        border: 1px solid var(--card-border);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .category-icon {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--accent);
    }

    .category-title {
        color: var(--text-primary);
        margin: 0;
        font-size: 1.25rem;
    }

    .category-highlight {
        color: var(--accent);
        font-weight: 700;
    }

    .count-badge {
        margin-left: auto;
        background-color: var(--primary-700);
        padding: 0.3rem 0.8rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent);
        border: 1px solid var(--card-border);
    }
</style>
