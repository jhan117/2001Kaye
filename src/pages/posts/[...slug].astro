---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";
import PostLayout from "@layouts/PostLayout.astro";
import type { Post } from "@types";

import { sortPostsByPubDate, calculateReadingTime } from "@utils/posts";

export const getStaticPaths = (async () => {
    const posts = await getCollection("posts");
    const sortedPosts = sortPostsByPubDate(posts as Post[]);
    const postsCount = sortedPosts.length;
    return sortedPosts.map((post, idx) => ({
        params: { slug: post.slug },
        props: {
            post,
            prevPost: idx + 1 === postsCount ? undefined : sortedPosts[idx + 1],
            nextPost: idx === 0 ? undefined : sortedPosts[idx - 1],
        },
    }));
}) satisfies GetStaticPaths;

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = calculateReadingTime(post.body || "");

export const prerender = true;
---

<Layout
    title={`${post.data.title} - 2001Kaye`}
    description={post.data.description}
>
    <PostLayout
        currPost={post}
        prevPost={prevPost}
        nextPost={nextPost}
        headings={headings}
        readingTime={readingTime}
    >
        <Content />
    </PostLayout>
</Layout>
